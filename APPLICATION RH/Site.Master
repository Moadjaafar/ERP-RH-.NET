        <!-- JavaScript Files -->
        <!-- Vendor -->
        <script src="/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
        <script src="/assets/libs/simplebar/simplebar.min.js"></script>
        <script src="/assets/libs/node-waves/waves.min.js"></script>
        <script src="/assets/libs/waypoints/lib/jquery.waypoints.min.js"></script>
        <script src="/assets/libs/jquery.counterup/jquery.counterup.min.js"></script>
        <script src="/assets/libs/feather-icons/feather.min.js"></script>

        <!-- App js-->
        <script src="/assets/js/app.js"></script>
        <script src="/assets/js/head.js"></script>

        <script type="text/javascript">
            $(document).ready(function () {
                setTimeout(function () {
                    activateMenuBasedOnUrl();
                }, 100);
            });

            function activateMenuBasedOnUrl() {
                var currentUrl = window.location.pathname.toLowerCase();
                var found = false;

                // Parcourir tous les liens dans le sidebar
                $(".nav-second-level a").each(function () {
                    var linkHref = $(this).attr('href');

                    if (linkHref) {
                        var linkUrl = linkHref.toLowerCase();

                        // Vérifier si c'est la page actuelle
                        if (currentUrl.indexOf(linkUrl) !== -1 || linkUrl.indexOf(currentUrl.split('/').pop()) !== -1) {
                            // Marquer le lien enfant comme actif
                            $(this).addClass("active");
                            $(this).parent().addClass("menuitem-active");

                            // Trouver et marquer le parent
                            var collapseParent = $(this).closest('.collapse');
                            if (collapseParent.length > 0) {
                                // Ouvrir le collapse
                                collapseParent.addClass("show");

                                // Trouver le LinkButton parent et le marquer comme actif
                                var parentLi = collapseParent.parent();
                                parentLi.addClass("menuitem-active");

                                // Marquer le bouton toggle comme actif
                                var toggleButton = parentLi.find('[data-bs-toggle="collapse"]');
                                toggleButton.removeClass('collapsed');
                                toggleButton.attr('aria-expanded', 'true');
                                toggleButton.addClass('active');
                            }

                            found = true;
                            return false;
                        }
                    }
                });

                // Correspondance partielle si pas trouvé
                if (!found) {
                    var pageName = currentUrl.split('/').pop().replace('.aspx', '').toLowerCase();

                    $(".nav-second-level a").each(function () {
                        var linkHref = $(this).attr('href');

                        if (linkHref && (linkHref.toLowerCase().indexOf(pageName) !== -1)) {
                            $(this).addClass("active");
                            $(this).parent().addClass("menuitem-active");

                            var collapseParent = $(this).closest('.collapse');
                            if (collapseParent.length > 0) {
                                collapseParent.addClass("show");
                                var parentLi = collapseParent.parent();
                                parentLi.addClass("menuitem-active");

                                var toggleButton = parentLi.find('[data-bs-toggle="collapse"]');
                                toggleButton.removeClass('collapsed');
                                toggleButton.attr('aria-expanded', 'true');
                                toggleButton.addClass('active');
                            }

                            return false;
                        }
                    });
                }
            }
            async function getWeatherData() {
                const cacheKey = 'weather_dakhla';
                const cacheTimeKey = 'weather_dakhla_timestamp';
                const cacheExpiryMinutes = 1000; // Cache for 30 minutes

                // Check if we have cached data
                const cachedData = localStorage.getItem(cacheKey);
                const cachedTime = localStorage.getItem(cacheTimeKey);

                if (cachedData && cachedTime) {
                    const now = new Date().getTime();
                    const cacheTime = parseInt(cachedTime);
                    const isExpired = (now - cacheTime) > (cacheExpiryMinutes * 60 * 1000);

                    if (!isExpired) {
                        // Use cached data
                        document.getElementById("weather-info").innerText = cachedData;
                        return;
                    }
                }

                // Fetch fresh data
                try {
                    const response = await fetch("https://wttr.in/Dakhla?format=3");
                    const data = await response.text();

                    // Cache the data
                    localStorage.setItem(cacheKey, data);
                    localStorage.setItem(cacheTimeKey, new Date().getTime().toString());

                    document.getElementById("weather-info").innerText = data;
                } catch (error) {
                    // If fetch fails, try to use cached data as fallback
                    if (cachedData) {
                        document.getElementById("weather-info").innerText = cachedData;
                    } else {
                        document.getElementById("weather-info").innerText = "Weather info unavailable";
                    }
                }
            }

            getWeatherData();
        </script>
        <!-- Zone de notification -->
        <div id="notification-area" style="position: fixed; top: 80px; right: 20px; z-index: 9999; width: 350px;"></div>

    </form>
</body>
</html>
